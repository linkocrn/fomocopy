# WebSocket RPC endpoints. Public RPCs do not support eth_subscribe, so these must
# be provider endpoints (QuickNode, Alchemy, ...).
RH_WSS=wss://your-endpoint.robinhood-mainnet.quiknode.pro/<key>/
BASE_WSS=wss://your-endpoint.base-mainnet.quiknode.pro/<key>/

# Telegram notifications, one message per leader trade (~5/hour right now).
# Leave either blank to disable.
# Token comes from @BotFather. For the chat id, message your bot once and read
# result[0].message.chat.id from:
#   https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional second bot that only alerts for leaders you /focus on the main bot.
# Same process, different BotFather token. Telegram will not split one bot's
# notifications, so the quiet tape has to be its own bot. Send it /start once.
TELEGRAM_FOCUS_BOT_TOKEN=
TELEGRAM_FOCUS_CHAT_ID=

# Which chains to watch, comma separated. Solana is deliberately not supported yet.
CHAINS=4663,8453
